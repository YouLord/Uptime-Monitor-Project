# Uptime Monitor - Environment Configuration
# Copy to .env and customize

# ─── Server ───
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ─── Database ───
# Use SQLite (default, file-based)
DB_PATH=./data/uptime.db

# Or use PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:pass@host:5432/uptime

# ─── JWT ───
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ─── Monitoring Defaults ───
DEFAULT_CHECK_INTERVAL=60
DEFAULT_TIMEOUT=10
DEFAULT_RETRIES=3
MAX_CONCURRENT_CHECKS=50

# ─── Alerting ───
ALERT_COOLDOWN=300
MAX_ALERT_HISTORY=1000

# ─── Telegram Bot ───
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID(s) to send alerts to (comma-separated)
TELEGRAM_CHAT_ID=

# ─── Email (SMTP) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Uptime Monitor <noreply@yourdomain.com>
ALERT_EMAIL_TO=alerts@example.com

# ─── Webhook ───
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
WEBHOOK_SECRET=your-webhook-secret

# ─── Dashboard ───
DASHBOARD_TITLE=Uptime Monitor
DASHBOARD_THEME=auto
ENABLE_REGISTRATION=false

# ─── Retention ───
RETENTION_DAYS=30
RETENTION_HOURLY_DAYS=90

# ─── Security ───
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
CORS_ORIGIN=*